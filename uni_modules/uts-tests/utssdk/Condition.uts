import { describe, test, expect, Result } from './tests.uts'

export function testCondition(): Result {
  return describe('Condition', () => {
    test('IfStatement truthy/falsy for string/number', () => {
      const str: string = 'hello'
      const emptyStr: string = ''
      const num: number = 123
      const zero: number = 0

      const logs: string[] = []
      if (str) {
        logs.push('str true')
      }
      if (emptyStr) {
        logs.push('emptyStr true')
      } else {
        logs.push('emptyStr false')
      }
      if (num) {
        logs.push('num true')
      }
      if (zero) {
        logs.push('zero true')
      } else {
        logs.push('zero false')
      }
      expect(logs).toEqual(['str true', 'emptyStr false', 'num true', 'zero false'])
    })

    test('WhileStatement truthy/falsy for string/number', () => {
      let str: string = 'hello'
      const emptyStr: string = ''
      let num: number = 123
      const zero: number = 0

      const logs: string[] = []
      let loop = 0

      while (str) {
        logs.push('while str')
        str = ''
        loop++
      }
      while (emptyStr) {
        logs.push('while emptyStr')
        loop++
      }
      while (num) {
        logs.push('while num')
        num = 0
        loop++
      }
      while (zero) {
        logs.push('while zero')
        loop++
      }

      expect(logs).toEqual(['while str', 'while num'])
      expect(loop).toEqual(2)
    })

    test('DoStatement truthy/falsy for string/number', () => {
      let str: string = 'hello'
      const emptyStr: string = ''
      let num: number = 123
      const zero: number = 0

      const logs: string[] = []
      let loop = 0

      do {
        logs.push('do str')
        str = ''
        loop++
      } while (str)

      do {
        logs.push('do emptyStr')
        loop++
      } while (emptyStr)

      do {
        logs.push('do num')
        num = 0
        loop++
      } while (num)

      do {
        logs.push('do zero')
        loop++
      } while (zero)

      expect(logs).toEqual(['do str', 'do emptyStr', 'do num', 'do zero'])
      expect(loop).toEqual(4)
    })

    test('ForStatement truthy/falsy for string/number', () => {
      let str: string = 'hello'
      const emptyStr: string = ''
      let num: number = 123
      const zero: number = 0

      const logs: string[] = []

      for (; str;) {
        logs.push('for str')
        str = ''
      }
      for (; emptyStr;) {
        logs.push('for emptyStr')
      }
      for (; num;) {
        logs.push('for num')
        num = 0
      }
      for (; zero;) {
        logs.push('for zero')
      }

      expect(logs).toEqual(['for str', 'for num'])
    })

    test('Truthiness for arithmetic expressions', () => {
      const logs: string[] = []
      const a: number = 5
      const b: number = 2
      const c: number = 10
      const d: number = 3

      if (a + b) {
        logs.push('a + b')
      }
      if (a - b) {
        logs.push('a - b')
      }
      if (b - b) {
        logs.push('b - b true')
      } else {
        logs.push('b - b false')
      }
      if (a * b) {
        logs.push('a * b')
      }
      if (a * 0) {
        logs.push('a * 0 true')
      } else {
        logs.push('a * 0 false')
      }
      if (a / b) {
        logs.push('a / b')
      }
      if (0 / b) {
        logs.push('0 / b true')
      } else {
        logs.push('0 / b false')
      }

      const inf: number = 1 / 0
      if (inf) {
        logs.push('1 / 0')
      }

      if (a % b) {
        logs.push('a % b')
      }
      if (4 % 2) {
        logs.push('4 % 2 true')
      } else {
        logs.push('4 % 2 false')
      }

      if (-1) {
        logs.push('-1')
      }
      if (-0) {
        logs.push('-0 true')
      } else {
        logs.push('-0 false')
      }

      if ((a + b) * (a - b)) {
        logs.push('compound product')
      }
      if ((a - 5) * (b - 2)) {
        logs.push('zero compound true')
      } else {
        logs.push('zero compound false')
      }
      if ((a + b + c) - (a + b + c)) {
        logs.push('sum cancel true')
      } else {
        logs.push('sum cancel false')
      }
      if ((c / d) * (d - b)) {
        logs.push('fraction * diff')
      }
      if (((a + b) * (c - d)) / (a + b)) {
        logs.push('cancel division')
      }
      if (((a + b) * (c - d)) / (a + b) - (c - d)) {
        logs.push('cancel to zero true')
      } else {
        logs.push('cancel to zero false')
      }
      if ((a * b) + (c * d) - (a * b) - (c * d)) {
        logs.push('multi cancel true')
      } else {
        logs.push('multi cancel false')
      }
      if ((a - b) * (b - a)) {
        logs.push('neg product')
      }
      if ((a + b) % (a - b)) {
        logs.push('mod compound')
      }

      expect(logs).toEqual([
        'a + b',
        'a - b',
        'b - b false',
        'a * b',
        'a * 0 false',
        'a / b',
        '0 / b false',
        '1 / 0',
        'a % b',
        '4 % 2 false',
        '-1',
        '-0 false',
        'compound product',
        'zero compound false',
        'sum cancel false',
        'fraction * diff',
        'cancel division',
        'cancel to zero false',
        'multi cancel false',
        'neg product',
        'mod compound'
      ])
    })

    test('Conditional/Unary/Logical operators', () => {
      const str: string = 'hello'
      const emptyStr: string = ''
      const num: number = 123
      const zero: number = 0

      const ternaryStr = str ? 'true' : 'false'
      const ternaryNum = num ? 'true' : 'false'
      expect(ternaryStr).toEqual('true')
      expect(ternaryNum).toEqual('true')

      const unaryLogs: string[] = []
      if (!emptyStr) {
        unaryLogs.push('!emptyStr true')
      }
      if (!zero) {
        unaryLogs.push('!zero true')
      }
      expect(unaryLogs).toEqual(['!emptyStr true', '!zero true'])

      const logicalLogs: string[] = []
      if (str && num) {
        logicalLogs.push('str && num')
      }
      if (emptyStr || zero) {
        logicalLogs.push('emptyStr || zero')
      } else {
        logicalLogs.push('emptyStr || zero false')
      }
      expect(logicalLogs).toEqual(['str && num', 'emptyStr || zero false'])

      const numA = 1
      const numB = 2
      const numC = numA || numB
      const numD = numA && numB
      const strC = emptyStr || str
      const strD = emptyStr && str
      expect(numC).toEqual(1)
      expect(numD).toEqual(2)
      expect(strC).toEqual('hello')
      expect(strD).toEqual('')

      const objA = { x: 1 }
      const objB = { x: 2 }
      const objC = objA || objB
      const objD = objA && objB
      expect(objC).toEqual(objA)
      expect(objD).toEqual(objB)
    })

    test('Logical operators with mixed boolean and non-boolean', () => {
      const str: string = 'hello'
      const num: number = 123

      // function getNumber(): number {
      //   return 10
      // }
      // function getString(): string {
      //   return 'test'
      // }
      // type M = { v: number }
      // function getObject(): M {
      //   return { v: 1 } as M
      // }

      const boolVal = true
      const boolAndStr = boolVal && str
      const boolOrNum = boolVal || num
      const strAndBool = str && boolVal
      const numOrBool = num || boolVal

      expect(boolAndStr).toEqual('hello')
      expect(boolOrNum).toEqual(true)
      expect(strAndBool).toEqual(true)
      expect(numOrBool).toEqual(123)
      
      // expect(getNumber() && str).toEqual('hello')
      // expect(getString() && num).toEqual(123)
      // expect(getObject() && boolVal).toEqual(true)
    })

    test('Truthiness for objects/booleans/functions/ref', () => {
      const logs: string[] = []

      let a = { b: 1 }
      if (a) {
        logs.push('a object true')
      }

      type Ma = { m: string }
      let b: Ma = { m: '1' }
      if (b) {
        logs.push('b interface true')
      }

      class MyClass {
        c: number = 1
      }
      let c = new MyClass()
      if (c) {
        logs.push('c class true')
      }

      if (true) {
        logs.push('true literal')
      }
      if (false) {
        logs.push('false literal')
      }

      const boolVar = true
      if (boolVar) {
        logs.push('boolVar')
      }

      const str: string = 'hello'
      const num: number = 123
      if (str == 'hello') {
        logs.push('str == hello')
      }
      if (num > 0) {
        logs.push('num > 0')
      }

      function getStr(): string {
        return 'test'
      }
      if (getStr()) {
        logs.push('getStr truthy')
      }

      function getNum(): number {
        return 1
      }
      if (getNum()) {
        logs.push('getNum truthy')
      }

      function getBool(): boolean {
        return true
      }
      if (getBool()) {
        logs.push('getBool truthy')
      }

      function getClassObj(): MyClass {
        return new MyClass()
      }
      if (getClassObj()) {
        logs.push('getClassObj truthy')
      }

      function getInterfaceObj(): Ma {
        return { m: 'test' }
      }
      if (getInterfaceObj()) {
        logs.push('getInterfaceObj truthy')
      }

      type O = { x: number }
      function getObjLiteral(): O {
        return { x: 1 } as O
      }
      if (getObjLiteral()) {
        logs.push('getObjLiteral truthy')
      }

      function wrapStr(s: string): string {
        return s
      }
      if (wrapStr(getStr())) {
        logs.push('wrapStr(getStr()) truthy')
      }

      if (getStr() && getNum()) {
        logs.push('getStr && getNum')
      }
      if (getBool() || getStr()) {
        logs.push('getBool || getStr')
      }

      const ternaryFunc = getStr() ? 'true' : 'false'
      expect(ternaryFunc).toEqual('true')

      if (!getStr()) {
        logs.push('!getStr truthy')
      }
      if (!getBool()) {
        logs.push('!getBool truthy')
      }

      function getNumA(): number {
        return 1
      }
      function getNumB(): number {
        return 2
      }
      // expect(getNumA() && getNumB()).toEqual(2)

      const refNumA = ref(1)
      const refNumB = ref(2)
      if (refNumA.value) {
        logs.push('refNumA.value true')
      }
      expect(refNumB.value).toEqual(2)

      expect(logs).toEqual([
        'a object true',
        'b interface true',
        'c class true',
        'true literal',
        'boolVar',
        'str == hello',
        'num > 0',
        'getStr truthy',
        'getNum truthy',
        'getBool truthy',
        'getClassObj truthy',
        'getInterfaceObj truthy',
        'getObjLiteral truthy',
        'wrapStr(getStr()) truthy',
        'getStr && getNum',
        'getBool || getStr',
        'refNumA.value true'
      ])
    })

    test('any type truthy/falsy tests', () => {
      const str: string = 'hello'
      let anyVal: any = 'hello'
      const logs: string[] = []

      if (anyVal) {
        logs.push('anyVal is truthy')
      }
      while (anyVal) {
        logs.push('while anyVal')
        break
      }
      const ternaryAny = anyVal ? 'true' : 'false'
      expect(ternaryAny).toEqual('true')

      if (!anyVal) {
        logs.push('!anyVal is truthy')
      }

      let anyA: any = 1
      let anyB: any = 2
      const anyOr = anyA || anyB
      const anyAnd = anyA && anyB
      expect(anyOr).toEqual(1)
      expect(anyAnd).toEqual(2)

      const anyOrStr = anyVal || str
      const strAndAny = str && anyVal
      expect(anyOrStr).toEqual('hello')
      expect(strAndAny).toEqual('hello')

      expect(logs).toEqual(['anyVal is truthy', 'while anyVal'])
    })

    test('union type truthy/falsy tests', () => {
      const logs: string[] = []

      let unionStrNum: string | number = 'test'
      if (unionStrNum) {
        logs.push('unionStrNum is truthy')
      }

      let unionStrNull: string | null = 'test'
      if (unionStrNull) {
        logs.push('unionStrNull is truthy')
      }

      let unionNumUndefined: number | undefined = 123
      if (unionNumUndefined) {
        logs.push('unionNumUndefined is truthy')
      }

      const unionOr = unionStrNum || unionStrNull
      const unionAnd = unionStrNum && unionStrNull
      expect(unionOr).toEqual('test')
      expect(unionAnd).toEqual('test')
      
      function unionFunction () : string | number {
        return ""
      }
      
      if (unionFunction()) {
        logs.push("=====")
      }

      expect(logs).toEqual([
        'unionStrNum is truthy',
        'unionStrNull is truthy',
        'unionNumUndefined is truthy'
      ])
    })

    test('generic function truthy/falsy tests', () => {
      const logs: string[] = []

      function checkGeneric<T>(val: T): string {
        if (val) {
          logs.push('generic val is truthy')
        }
        const ternaryGeneric = val ? 'true' : 'false'
        return ternaryGeneric
      }
      expect(checkGeneric('hello')).toEqual('true')
      expect(checkGeneric(123)).toEqual('true')
      expect(checkGeneric({ x: 1 })).toEqual('true')

      function checkGenericWithConstraint<T extends object>(val: T): void {
        if (val) {
          logs.push('generic constrained val is truthy')
        }
      }
      checkGenericWithConstraint({ x: 1 })

      function genericLogical<T>(a: T, b: T): T {
        const result = a || b
        return result
      }
      expect(genericLogical('a', 'b')).toEqual('a')

      expect(logs).toEqual([
        'generic val is truthy',
        'generic val is truthy',
        'generic val is truthy',
        'generic constrained val is truthy'
      ])
    })

    test('void and function return truthy tests', () => {
      const logs: string[] = []

      function returnsVoid(): void {
        logs.push('side effect')
      }
      let voidResult: void = returnsVoid()
      if (voidResult) {
        logs.push('voidResult is truthy')
      }

      function getAny(): any {
        return 'dynamic'
      }
      if (getAny()) {
        logs.push('getAny() is truthy')
      }

      let anyVal: any = 'hello'
      let unionStrNum: string | number = 'test'
      if (anyVal && unionStrNum) {
        logs.push('anyVal && unionStrNum truthy')
      }

      expect(logs).toEqual([
        'side effect',
        'getAny() is truthy',
        'anyVal && unionStrNum truthy'
      ])
    })
  })
}
